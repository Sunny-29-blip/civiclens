# ==============================================================================
# CivicLens Root & Backend Environment Template
# ==============================================================================

# Google Cloud Gemini AI Configuration
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase & Google Cloud Firestore Configuration
# (Optional: If credentials omitted, CivicLens runs in local JSON database mode)
FIREBASE_PROJECT_ID=jansetu-d2106
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Demo & Simulation Authentication
DEMO_OTP=123456
SECRET_KEY=civiclens-secure-session-key-2026

# Frontend Vite Configuration (for frontend/.env)
# VITE_API_URL=http://localhost:8000
# VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=jansetu-d2106
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
# VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
