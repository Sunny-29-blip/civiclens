{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*",        "destination": "/api/index" },
    { "source": "/auth/:path*",       "destination": "/api/index" },
    { "source": "/requests/:path*",   "destination": "/api/index" },
    { "source": "/public/:path*",     "destination": "/api/index" },
    { "source": "/officials/:path*",  "destination": "/api/index" },
    { "source": "/docs",              "destination": "/api/index" },
    { "source": "/redoc",             "destination": "/api/index" },
    { "source": "/openapi.json",      "destination": "/api/index" },
    { "source": "/(.*)",              "destination": "/index.html" }
  ]
}
