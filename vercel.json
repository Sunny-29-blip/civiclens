{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)",       "dest": "api/index.py" },
    { "src": "/api",            "dest": "api/index.py" },
    { "src": "/auth/(.*)",       "dest": "api/index.py" },
    { "src": "/auth",            "dest": "api/index.py" },
    { "src": "/requests/(.*)",   "dest": "api/index.py" },
    { "src": "/requests",        "dest": "api/index.py" },
    { "src": "/public/(.*)",     "dest": "api/index.py" },
    { "src": "/public",          "dest": "api/index.py" },
    { "src": "/officials/(.*)",  "dest": "api/index.py" },
    { "src": "/officials",       "dest": "api/index.py" },
    { "src": "/docs",            "dest": "api/index.py" },
    { "src": "/redoc",           "dest": "api/index.py" },
    { "src": "/openapi.json",    "dest": "api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)",            "dest": "/index.html" }
  ]
}
